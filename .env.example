# Public Shopify Storefront API config (client-side)
# IMPORTANT: This is the public Storefront access token, NOT the Admin API key.
# Restrict your Storefront token to your domain in Shopify settings.

VITE_SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_token

# Use mock data if true or 1 (defaults to true if not set)
VITE_USE_MOCK=true

# Razorpay Standard Checkout public key (client-side)
# If omitted and/or when VITE_USE_MOCK is true, checkout will run in mock mode.
VITE_RAZORPAY_KEY_ID=rzp_test_1234567890abcdef
